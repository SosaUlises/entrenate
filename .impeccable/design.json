  "narrative": {
    "northStar": "Precisión en movimiento",
    "overview": "Acero Térmico convierte Entrenate en un instrumento deportivo digital: carbón, grafito, acero, blanco técnico y una señal térmica contenida. Training es la referencia visual. La jerarquía nace de datos, tipografía, espacio, feedback y materialidad, sin decoración futurista.",
    "keyCharacteristics": [
      "Dark-first y mobile-first.",
      "Blanco técnico para acción y datos protagonistas.",
      "Señal térmica breve para foco, avance y performance.",
      "Acero para información.",
      "Superficies planas y capas elevadas solo cuando se superponen.",
      "Targets de 44–48px y texto funcional mínimo de 13px."
    ],
    "rules": [
      { "name": "Primary is not accent", "body": "Primary es la acción cerámica sólida; Thermal Accent es una señal pequeña y contextual.", "section": "colors" },
      { "name": "Color is signal", "body": "El color comunica interacción, información o estado; nunca reemplaza jerarquía.", "section": "colors" },
      { "name": "Flat by default", "body": "Espacio, tipografía, divisores y bordes resuelven jerarquía antes que elevación.", "section": "elevation" },
      { "name": "Operational legibility", "body": "Datos y controles frecuentes priorizan lectura inmediata, targets amplios y una columna clara.", "section": "typography" },
      { "name": "Firm geometry", "body": "Los radios 8/12/16/18 expresan escala sin suavizar toda la interfaz.", "section": "shapes" },
      { "name": "Functional motion", "body": "El movimiento de 150–220ms confirma, encaja, avanza o guarda.", "section": "motion" }
    ],
    "dos": [
      "Do usar blanco técnico para la acción primaria.",
      "Do usar señal térmica como marcador contenido.",
      "Do usar acero para información.",
      "Do mantener foco visible y texto funcional desde 13px.",
      "Do validar 390×667 antes que desktop."
    ],
    "donts": [
      "Don't usar gradientes, glow, halos o glassmorphism.",
      "Don't llenar superficies con el acento térmico.",
